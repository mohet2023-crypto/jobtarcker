# Application environment: development | production
APP_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/deadline_dash

# JWT authentication (required)
# Generate a long random value for production. Never commit the real secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origin allowed by CORS (no wildcards)
# Development default twin of localhost/127.0.0.1 is applied automatically.
FRONTEND_ORIGIN=http://localhost:5173

# Optional comma-separated TrustedHost allowlist for production
# Example: api.example.com,localhost
# Leave empty locally so TrustedHost middleware is not enabled.
ALLOWED_HOSTS=

# Himalayas remote jobs ingestion (optional; no API key required)
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
# Max browse pages per ingest run (20 jobs per page; keep low for local dev)
HIMALAYAS_MAX_PAGES=1
