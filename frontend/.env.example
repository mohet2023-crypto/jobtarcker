# API origin only (no /api/v1). Service paths already include /api/v1.
# Development:
VITE_API_BASE_URL=http://127.0.0.1:8001

# Production example (set in hosting/CI or frontend/.env.production):
# VITE_API_BASE_URL=https://deadline-dash-api.onrender.com
#
# Do not put secrets in VITE_* variables. Anything prefixed with VITE_
# is embedded into the browser bundle.
